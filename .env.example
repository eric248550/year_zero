# Path to the SQLite database. Relative paths resolve from the repository root.
GENESIS_DB_PATH=data/genesis.db

# --- Optional AI provider ---------------------------------------------------
# Leave empty to run Genesis Studio without an AI model. The Studio still works;
# the event generator offers a clearly-labelled deterministic MOCK generator.
#
# GENESIS_AI_PROVIDER: "anthropic" | "mock" (auto-detected when unset:
# anthropic if ANTHROPIC_API_KEY is present, otherwise none)
GENESIS_AI_PROVIDER=
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5

# --- Live play -----------------------------------------------------------------
# Minutes of real time per world year for the player app (/play). 240 = playtest
# speed (4 hours per year), 1440 = one real day. Empty = manual stepping only.
GENESIS_TICK_MINUTES=
